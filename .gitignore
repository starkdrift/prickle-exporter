# Build artifacts — the two release binaries (SPEC §Distribution) and build dirs.
# Root-anchored so a `prickle/` package dir would never be ignored by accident.
/prickle
/prickle-nvml
/bin/
/dist/
# Release staging (.github/workflows/release.yml). This entry is load-bearing,
# not tidiness: Go stamps vcs.modified into every binary it builds, so an
# untracked build/ in the working tree makes the *second* architecture in the
# release loop come out as vX.Y.Z+dirty while the first is clean. Ignored files
# do not count as modifications, so listing it here is what keeps the release
# honest. Removing this line silently corrupts release provenance.
/build/

# Go test / coverage output.
# Deliberately NOT ignoring *.out — exposition golden files may use that suffix.
*.test
*.coverprofile
coverage.out
cover.out
covdata/

# Raw fixture captures from scripts/capture-fixtures.sh.
# Host-specific dumps (hostnames, image/process names, PIDs) — never committed
# as-is; curate the needed files into testdata/ instead. testdata/ stays tracked.
prickle-fixtures-*/
prickle-fixtures-*.tar.gz

# Go workspace overlay (keep go.mod / go.sum tracked).
go.work
go.work.sum

# Local env / secrets.
.env
.env.local
*.local.env

# Editor / OS cruft.
.idea/
.vscode/
*.swp
*~
.DS_Store
