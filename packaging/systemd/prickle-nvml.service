# SPDX-License-Identifier: Apache-2.0
#
# prickle-nvml — the NVML variant, for hosts with an NVIDIA driver.
#
# Identical to prickle.service but for one directive, which is fewer than the
# first draft assumed. PrivateDevices cannot be used: NVML talks to
# /dev/nvidiactl and /dev/nvidia<N> directly, so those devices are allowed back
# — read-write, because the driver's ioctl interface is not usable read-only,
# and named individually rather than by wildcard.
#
# Everything else survives unchanged, including MemoryDenyWriteExecute, which
# the first draft gave up on a guess that testing disproved. ProtectSystem
# stays strict; the driver's shared libraries live under /usr and dlopen needs
# no more than read access to find them.
#
# SPEC.md §Hard constraints #2 still holds: no NVML call that mutates device
# state is ever made. Write access to the device node is what the driver's
# ioctl interface requires to answer a query, not permission this exporter uses
# to change anything.
#
# Install:
#   install -m 0755 prickle-nvml /usr/local/bin/prickle-nvml
#   install -m 0644 prickle-nvml.service /etc/systemd/system/
#   command -v restorecon >/dev/null && restorecon /etc/systemd/system/prickle-nvml.service
#   systemctl daemon-reload && systemctl enable --now prickle-nvml
#
# See prickle.service for why restorecon is there: without it an SELinux host
# can report "Unit not found" for a file that is visibly present.

[Unit]
Description=prickle-exporter, NVML variant (host, container and GPU metrics)
Documentation=https://github.com/starkdrift/prickle-exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/prickle-nvml
Restart=on-failure
RestartSec=5s

DynamicUser=yes
SupplementaryGroups=video

# --- Filesystem -----------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes

# --- Privilege ------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
# Nothing is created, but a default of 0022 is still flagged by
# `systemd-analyze security` and costs nothing to close.
UMask=0077

# --- Kernel ---------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes

# Kept on. The first draft of this unit disabled it, on the reasoning that the
# NVIDIA driver maps writable-executable memory into its clients — plausible,
# widely repeated, and false for this binary: forcing it back on and restarting
# on an H100 with driver 580 still yields source="nvml" and a full set of GPU
# series. prickle makes query-only NVML calls and never JITs, which is the
# difference. Tested rather than assumed, because the assumption would have
# silently cost a hardening directive for nothing.
MemoryDenyWriteExecute=yes

# --- Devices --------------------------------------------------------------
# Named individually. A host with more GPUs needs more lines, which is
# deliberate: a wildcard would also match a card added later that nobody
# intended this service to see.
PrivateDevices=no
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia1 rw
DeviceAllow=/dev/nvidia2 rw
DeviceAllow=/dev/nvidia3 rw
DeviceAllow=/dev/nvidia4 rw
DeviceAllow=/dev/nvidia5 rw
DeviceAllow=/dev/nvidia6 rw
DeviceAllow=/dev/nvidia7 rw

# --- Syscalls and sockets -------------------------------------------------
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The ~ prefix applies to the whole line: every set after it is denied.
# Repeating ~ per set makes systemd read the rest as literal syscall names
# and ignore them, which silently left only @privileged denied.
SystemCallFilter=~@privileged @resources @obsolete @mount @reboot @swap
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# --- Pod names (optional) ---------------------------------------------------
# -collector.container.pod-names reads /var/log/pods, which is root:root 0750
# on every node. To enable it, add a drop-in rather than editing this file:
#
#   systemctl edit prickle-nvml
#   [Service]
#   ExecStart=
#   ExecStart=/usr/local/bin/prickle-nvml -collector.container.pod-names
#   AmbientCapabilities=CAP_DAC_READ_SEARCH
#   CapabilityBoundingSet=CAP_DAC_READ_SEARCH
#
# Understand what that grants before you do. CAP_DAC_READ_SEARCH bypasses file
# read and directory search permission checks everywhere — it was verified to
# read /etc/shadow in the same test that verified it reads /var/log/pods. For a
# process whose only power is reading files, it is close to the whole of root.
# Without it the exporter still reports every container; pods are identified by
# UID rather than by name.

[Install]
WantedBy=multi-user.target
