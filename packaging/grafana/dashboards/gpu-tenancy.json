{
  "description": "Which workload is on which accelerator. Starkdrift \u00b7 prickle-exporter.",
  "editable": true,
  "links": [
    {
      "icon": "external link",
      "targetBlank": true,
      "title": "prickle-exporter",
      "tooltip": "Starkdrift \u00b7 prickle-exporter",
      "type": "link",
      "url": "https://github.com/starkdrift/prickle-exporter"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Cards",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Cards matching the current filters.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "count(prickle_gpu_info{node=~\"$node\",gpu_uuid=~\"$gpu\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "GPUs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Zero on unpartitioned cards. MIG instances are their own families, never a label on the card's series, so a sum over cards does not double-count them.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "count(prickle_gpu_mig_info{node=~\"$node\",gpu_uuid=~\"$gpu\",mig_uuid=~\"$mig\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "MIG instances",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum(prickle_gpu_memory_used_bytes{node=~\"$node\",gpu_uuid=~\"$gpu\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Memory used",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum(prickle_gpu_power_watts{node=~\"$node\",gpu_uuid=~\"$gpu\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Power",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max(prickle_gpu_temperature_celsius{node=~\"$node\",gpu_uuid=~\"$gpu\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Hottest card",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "nvml or smi. The two must report identically; this says which one answered.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "count by (source) (prickle_gpu_nvidia_source_info)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Live source",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "title": "Utilization",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "ABSENT, not zero, once MIG is enabled \u2014 the driver reports [N/A] and reporting zero would fire idle-capacity alerts across a MIG fleet. A gap here on a MIG card is correct.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "label_join((prickle_gpu_utilization_ratio{node=~\"$node\",gpu_uuid=~\"$gpu\"} * 100) * on (gpu_uuid) group_left(index) max by (gpu_uuid, index) (prickle_gpu_info), \"gpu\", \"/\", \"node\", \"index\", \"gpu_uuid\")",
          "legendFormat": "{{gpu}}",
          "refId": "A"
        }
      ],
      "title": "GPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "label_join((prickle_gpu_memory_used_bytes{node=~\"$node\",gpu_uuid=~\"$gpu\"}) * on (gpu_uuid) group_left(index) max by (gpu_uuid, index) (prickle_gpu_info), \"gpu\", \"/\", \"node\", \"index\", \"gpu_uuid\")",
          "legendFormat": "{{gpu}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "label_join((prickle_gpu_memory_total_bytes{node=~\"$node\",gpu_uuid=~\"$gpu\"}) * on (gpu_uuid) group_left(index) max by (gpu_uuid, index) (prickle_gpu_info), \"gpu\", \"/\", \"node\", \"index\", \"gpu_uuid\")",
          "legendFormat": "{{gpu}} total",
          "refId": "B"
        }
      ],
      "title": "Memory used per card",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [],
      "title": "MIG partitions",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "A separate family from the card's memory: an instance's memory is a partition of its parent's, and one family holding both would double-count under sum().",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_gpu_mig_memory_used_bytes{node=~\"$node\",gpu_uuid=~\"$gpu\",mig_uuid=~\"$mig\"}",
          "legendFormat": "{{mig_uuid}}",
          "refId": "A"
        }
      ],
      "title": "MIG memory used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "profile comes from the driver's compute-instance name, the same string nvidia-smi -L prints. Deriving it from memory was wrong on every H200 profile.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_gpu_mig_info{node=~\"$node\",gpu_uuid=~\"$gpu\",mig_uuid=~\"$mig\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "MIG topology",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": [],
      "title": "Per-process (opt-in)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Which pod is holding which card, as <node>/<gpu-index>/<pod>/<container>. The container comes from the GPU process's own /proc/<pid>/cgroup and the pod is joined from prickle_container_info, so a process outside a container reads `host` in both positions rather than leaving a blank segment. Requires -collector.gpu.per-process, which on Kubernetes also needs CAP_SYS_PTRACE: reading a foreign process's exe link is a PTRACE_MODE_READ operation and Yama ptrace_scope=1 is the default on Debian and Ubuntu.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "label_join(label_replace(label_replace(label_replace(label_replace(label_replace(((sum by (node, gpu_uuid, container) (prickle_gpu_process_memory_bytes{node=~\"$node\",gpu_uuid=~\"$gpu\"})) * on (gpu_uuid) group_left(index) max by (gpu_uuid, index) (prickle_gpu_info)) * on (container) group_left(pod, pod_name) max by (container, pod, pod_name) (prickle_container_info), \"cshort\", \"host\", \"container\", \"^$\"), \"cshort\", \"$1\", \"container\", \"^(.{1,12}).*$\"), \"pshort\", \"host\", \"container\", \"^$\"), \"pshort\", \"$1\", \"pod\", \"^(.{1,8}).*$\"), \"pshort\", \"$1\", \"pod_name\", \"^(.+)$\"), \"workload\", \"/\", \"node\", \"index\", \"pshort\", \"cshort\")",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "GPU memory by pod and container",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Requires -collector.gpu.per-process. Keyed on `command`, the basename of the exe symlink \u2014 never a PID, which SPEC.md \u00a7Metrics contract forbids anywhere. Empty unless the flag is set. Under the nvidia-smi source these carry gpu_uuid only: that source cannot attribute a process to a MIG instance.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "label_join((sum by (node, command, gpu_uuid) (prickle_gpu_process_memory_bytes{node=~\"$node\",gpu_uuid=~\"$gpu\"})) * on (gpu_uuid) group_left(index) max by (gpu_uuid, index) (prickle_gpu_info), \"gpu\", \"/\", \"node\", \"index\", \"gpu_uuid\")",
          "legendFormat": "{{gpu}} / {{command}}",
          "refId": "A"
        }
      ],
      "title": "GPU memory by command",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "prickle",
    "starkdrift"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Data source",
        "name": "DS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on node. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "node contains",
        "name": "node_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "node",
        "multi": true,
        "name": "node",
        "query": {
          "query": "label_values(prickle_collector_series, node)",
          "refId": "node-values"
        },
        "refresh": 2,
        "regex": "/.*$node_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on namespace. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "namespace contains",
        "name": "namespace_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "namespace",
        "multi": true,
        "name": "namespace",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\"}, namespace)",
          "refId": "namespace-values"
        },
        "refresh": 2,
        "regex": "/.*$namespace_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on pod. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "pod contains",
        "name": "pod_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "pod",
        "multi": true,
        "name": "pod",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\",namespace=~\"$namespace\"}, pod)",
          "refId": "pod-values"
        },
        "refresh": 2,
        "regex": "/.*$pod_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on container. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "container contains",
        "name": "container_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "container",
        "multi": true,
        "name": "container",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\",namespace=~\"$namespace\",pod=~\"$pod\"}, container)",
          "refId": "container-values"
        },
        "refresh": 2,
        "regex": "/.*$container_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on gpu_uuid. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "gpu_uuid contains",
        "name": "gpu_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "gpu_uuid",
        "multi": true,
        "name": "gpu",
        "query": {
          "query": "label_values(prickle_gpu_info{node=~\"$node\"}, gpu_uuid)",
          "refId": "gpu-values"
        },
        "refresh": 2,
        "regex": "/.*$gpu_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on mig_uuid. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "mig_uuid contains",
        "name": "mig_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "mig_uuid",
        "multi": true,
        "name": "mig",
        "query": {
          "query": "label_values(prickle_gpu_mig_info{node=~\"$node\",gpu_uuid=~\"$gpu\"}, mig_uuid)",
          "refId": "mig-values"
        },
        "refresh": 2,
        "regex": "/.*$mig_search.*/",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "GPU Tenancy",
  "uid": "prickle-gpu-tenancy"
}
