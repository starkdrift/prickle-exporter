{
  "description": "One node's CPU, memory, disks, network and pressure. Starkdrift \u00b7 prickle-exporter.",
  "editable": true,
  "links": [
    {
      "icon": "external link",
      "targetBlank": true,
      "title": "prickle-exporter",
      "tooltip": "Starkdrift \u00b7 prickle-exporter",
      "type": "link",
      "url": "https://github.com/starkdrift/prickle-exporter"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Load",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "count(count by (node) (prickle_collector_series{node=~\"$node\"}))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Nodes",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "100 - (avg(rate(prickle_host_cpu_seconds_total{node=~\"$node\",mode=\"idle\"}[5m])) * 100)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "CPU busy",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum(prickle_host_memory_mem_total_bytes{node=~\"$node\"} - prickle_host_memory_mem_available_bytes{node=~\"$node\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Memory used",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max(prickle_host_load1{node=~\"$node\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Load 1m",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "A scrape serves the last completed render, so this is the age of the data, not of the request. Rising means the sampler is behind.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max(time() - prickle_render_timestamp_seconds{node=~\"$node\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Scrape age",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "title": "CPU and memory",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Aggregate across cores. Per-core series are opt-in behind -collector.cpu.per-core as a separate family, so default cardinality does not scale with core count.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (mode) (rate(prickle_host_cpu_seconds_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "title": "CPU time by mode",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_host_memory_mem_total_bytes{node=~\"$node\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_host_memory_mem_available_bytes{node=~\"$node\"}",
          "legendFormat": "available",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_host_memory_cached_bytes{node=~\"$node\"}",
          "legendFormat": "cached",
          "refId": "C"
        }
      ],
      "title": "Memory",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [],
      "title": "Disk, network, pressure",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (device) (rate(prickle_host_disk_read_bytes_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{device}} read",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (device) (rate(prickle_host_disk_written_bytes_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{device}} write",
          "refId": "B"
        }
      ],
      "title": "Disk throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (interface) (rate(prickle_host_network_receive_bytes_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{interface}} rx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (interface) (rate(prickle_host_network_transmit_bytes_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{interface}} tx",
          "refId": "B"
        }
      ],
      "title": "Network throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "EMPTY ON THE WHOLE RHEL FAMILY. Alma, Rocky and CentOS Stream ship PSI compiled in but disabled; it needs psi=1 at boot. Also absent on kernels older than 4.20. Blank here is a property of the host, not a fault.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (resource, kind) (rate(prickle_host_pressure_stalled_seconds_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{resource}} {{kind}}",
          "refId": "A"
        }
      ],
      "title": "Pressure stall",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "prickle",
    "starkdrift"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Data source",
        "name": "DS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on node. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "node contains",
        "name": "node_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "node",
        "multi": true,
        "name": "node",
        "query": {
          "query": "label_values(prickle_collector_series, node)",
          "refId": "node-values"
        },
        "refresh": 2,
        "regex": "/.*$node_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on namespace. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "namespace contains",
        "name": "namespace_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "namespace",
        "multi": true,
        "name": "namespace",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\"}, namespace)",
          "refId": "namespace-values"
        },
        "refresh": 2,
        "regex": "/.*$namespace_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on pod. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "pod contains",
        "name": "pod_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "pod",
        "multi": true,
        "name": "pod",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\",namespace=~\"$namespace\"}, pod)",
          "refId": "pod-values"
        },
        "refresh": 2,
        "regex": "/.*$pod_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on container. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "container contains",
        "name": "container_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "container",
        "multi": true,
        "name": "container",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\",namespace=~\"$namespace\",pod=~\"$pod\"}, container)",
          "refId": "container-values"
        },
        "refresh": 2,
        "regex": "/.*$container_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on gpu_uuid. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "gpu_uuid contains",
        "name": "gpu_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "gpu_uuid",
        "multi": true,
        "name": "gpu",
        "query": {
          "query": "label_values(prickle_gpu_info{node=~\"$node\"}, gpu_uuid)",
          "refId": "gpu-values"
        },
        "refresh": 2,
        "regex": "/.*$gpu_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on mig_uuid. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "mig_uuid contains",
        "name": "mig_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "mig_uuid",
        "multi": true,
        "name": "mig",
        "query": {
          "query": "label_values(prickle_gpu_mig_info{node=~\"$node\",gpu_uuid=~\"$gpu\"}, mig_uuid)",
          "refId": "mig-values"
        },
        "refresh": 2,
        "regex": "/.*$mig_search.*/",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Node Overview",
  "uid": "prickle-node-overview"
}
