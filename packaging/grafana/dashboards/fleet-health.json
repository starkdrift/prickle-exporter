{
  "description": "The exporter watching itself: collector health, cardinality, versions. Starkdrift \u00b7 prickle-exporter.",
  "editable": true,
  "links": [
    {
      "icon": "external link",
      "targetBlank": true,
      "title": "prickle-exporter",
      "tooltip": "Starkdrift \u00b7 prickle-exporter",
      "type": "link",
      "url": "https://github.com/starkdrift/prickle-exporter"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Exporter",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "count(count by (node) (prickle_collector_series{node=~\"$node\"}))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Nodes reporting",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "A collector can fail and still emit: partial data plus a raised error total beats an empty family.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "count(prickle_collector_success{node=~\"$node\"} == 0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Collectors failing",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Non-zero means a cardinality cap fired and a collector's tail was discarded. The default cap is far above any real host, so this should be flat zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum(increase(prickle_collector_series_dropped_total{node=~\"$node\"}[1h])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Series dropped",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max(prickle_collector_duration_seconds{node=~\"$node\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Slowest collector",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max(time() - prickle_render_timestamp_seconds{node=~\"$node\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Oldest scrape",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "title": "Collectors",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Per-collector, per pass. A collector approaching -collector.timeout is the thing to catch before it starts being killed.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_collector_duration_seconds{node=~\"$node\"}",
          "legendFormat": "{{node}} {{collector}}",
          "refId": "A"
        }
      ],
      "title": "Collector duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "On a GPU host using the nvidia-smi source, a steady error rate here is usually NVIDIA persistence mode being off: each nvidia-smi then re-initialises the driver and the pass overruns its deadline. `nvidia-smi -pm 1`.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (collector) (increase(prickle_collector_errors_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{collector}}",
          "refId": "A"
        }
      ],
      "title": "Collector errors",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [],
      "title": "Cardinality",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Useful whether or not a cap is set. A step change usually means a host gained containers, changed cgroup driver, or switched container runtime \u2014 containerd gives a pod sandbox its own cgroup and CRI-O does not, so the same pods count differently.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_collector_series{node=~\"$node\"}",
          "legendFormat": "{{node}} {{collector}}",
          "refId": "A"
        }
      ],
      "title": "Series per collector",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Emitted outside every collector's own budget on purpose: a breach that erased its own evidence would leave a truncated scrape looking like a healthy smaller one.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (node, collector) (increase(prickle_collector_series_dropped_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{node}} {{collector}}",
          "refId": "A"
        }
      ],
      "title": "Series dropped",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": [],
      "title": "Build",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "Git tags are the only source of version truth; there is no VERSION file. Two versions here means a partial rollout.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "prickle_build_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Versions in the fleet",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "prickle",
    "starkdrift"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Data source",
        "name": "DS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on node. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "node contains",
        "name": "node_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "node",
        "multi": true,
        "name": "node",
        "query": {
          "query": "label_values(prickle_collector_series, node)",
          "refId": "node-values"
        },
        "refresh": 2,
        "regex": "/.*$node_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on namespace. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "namespace contains",
        "name": "namespace_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "namespace",
        "multi": true,
        "name": "namespace",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\"}, namespace)",
          "refId": "namespace-values"
        },
        "refresh": 2,
        "regex": "/.*$namespace_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on pod. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "pod contains",
        "name": "pod_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "pod",
        "multi": true,
        "name": "pod",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\",namespace=~\"$namespace\"}, pod)",
          "refId": "pod-values"
        },
        "refresh": 2,
        "regex": "/.*$pod_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on container. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "container contains",
        "name": "container_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "container",
        "multi": true,
        "name": "container",
        "query": {
          "query": "label_values(prickle_container_info{node=~\"$node\",namespace=~\"$namespace\",pod=~\"$pod\"}, container)",
          "refId": "container-values"
        },
        "refresh": 2,
        "regex": "/.*$container_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on gpu_uuid. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "gpu_uuid contains",
        "name": "gpu_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "gpu_uuid",
        "multi": true,
        "name": "gpu",
        "query": {
          "query": "label_values(prickle_gpu_info{node=~\"$node\"}, gpu_uuid)",
          "refId": "gpu-values"
        },
        "refresh": 2,
        "regex": "/.*$gpu_search.*/",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring match on mig_uuid. Wrapped as .*input.* \u2014 leave empty for all.",
        "hide": 0,
        "label": "mig_uuid contains",
        "name": "mig_search",
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "mig_uuid",
        "multi": true,
        "name": "mig",
        "query": {
          "query": "label_values(prickle_gpu_mig_info{node=~\"$node\",gpu_uuid=~\"$gpu\"}, mig_uuid)",
          "refId": "mig-values"
        },
        "refresh": 2,
        "regex": "/.*$mig_search.*/",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Fleet Health",
  "uid": "prickle-fleet-health"
}
